build
install
log
site/*

.claude/*.local*

# Ignore micro-ros files from robot
src/micro_ros_setup
src/uros

# Override global ~/.gitignore_global which ignores *.so — we want kinematics
# libs (and any vendored shared libraries) tracked through LFS
!*.so

# Python compiled artifacts
__pycache__/
*.py[cod]
*$py.class

# Python packaging artifacts
*.egg
*.egg-info/

# ROS 1 / catkin build artifacts (devel; build is already covered above)
devel/

# Jupyter cache + LSP shadow files
.ipynb_checkpoints/
.virtual_documents/

# colcon / ament package-exclusion markers.
# setup_robot.sh drops these into viz+sim packages so the robot never builds them
# and rosdep never pulls rviz2 / gazebo onto the Pi. Machine-local, never committed.
COLCON_IGNORE
!third_party/COLCON_IGNORE
.ignored_pkgs/
